ANTHROPIC_API_KEY=sk-ant-...   # required for auto model selection
CLAUDE_BIN=claude                        # path to claude CLI binary
PORT=3456
MCP_PORT=3947
DB_PATH=./data/orchestrator.db
MAX_CONCURRENT_AGENTS=5
DEFAULT_MAX_TURNS=50
LOCK_TTL_MS=600000
QUESTION_TIMEOUT_MS=300000
SENTRY_DSN=                              # Sentry DSN for error tracking (optional)

# Dashboard access; optional for a trusted local-only setup
AUTH_TOKEN=
HOST=127.0.0.1
MCP_HOST=127.0.0.1
CODEX_BIN=codex

# Batch routine supervisor checks; warnings/failures/lifecycle events bypass this interval.
WATCHER_ROUTINE_INTERVAL_MS=30000

# Inherit Codex CLI tier preferences, including Ultrafast where eligible.
# Explicit phase overrides are optional: ASSESS / REVIEW / IMPLEMENT / VERIFY / DEFAULT.
# CODEX_SERVICE_TIER_REVIEW=ultrafast

# Claude Fast costs extra. Opt in for implementation jobs only (Claude Code >=2.1.205).
# Leave both unset to preserve existing CLI settings.
# CLAUDE_FAST_MODE_IMPLEMENT=true
# Optional comma-separated workflow IDs. A present but empty list matches no workflows.
# CLAUDE_FAST_MODE_WORKFLOW_IDS=your-workflow-id
